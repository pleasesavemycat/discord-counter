# Copy this file to ".env" and fill in your bot token.
# Get the token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token

DISCORD_TOKEN=your-bot-token-here

# Optional: how often (in minutes) to refresh the channel topic so the
# "days since last seen" figure stays current even without new sightings.
# Must stay comfortably above the ~2-edits-per-10-minutes rate limit.
TOPIC_REFRESH_MINUTES=60

# Optional: minimum seconds between topic edits (how fast the count can update).
# Discord allows ~2 topic edits per 10 minutes per channel, so 300 (5 min) is
# the practical floor. Going lower risks 429 rate limits, which make updates
# lag MORE, not less. Raise it if you want to be gentler on the API.
TOPIC_MIN_INTERVAL_SECONDS=300

# ---- Docker only ------------------------------------------------------------
#
# Only needed for `docker compose` from a shell. Installing through the NAS
# Docker app instead? Set these as environment variables in its UI; this file
# isn't involved. See the README.

# Host folder bind-mounted at /app/data inside the container (where state.json
# lives). Defaults to ./data next to docker-compose.yml.
# DATA_PATH=/volume1/docker/discord-counter/data

# Container timezone. Affects log timestamps only — the year-to-date rollover
# is always computed in UTC.
# TZ=America/Los_Angeles

# The entrypoint chowns the mounted data folder to this uid/gid and runs the
# bot as it. Change only if the state file must be owned by a specific user.
# PUID=1000
# PGID=1000
